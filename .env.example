# Model access. Copy to .env, fill in one of the three blocks, and load it:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# .env is gitignored. Nothing in agent-red reads it on its own, and no key is ever passed on
# the command line or written into a run directory.
#
# With none of AGENTRED_LLM_ROUTE set, the route is detected from whichever credentials are
# present, preferring Claude Platform on AWS, then Bedrock, then the first-party API. Set the
# route explicitly whenever you hold more than one set. `uv run agentred doctor` reports which
# one resolved.

# --- Block 1: the Anthropic API directly. If you have a key and nothing else, this is enough.
# AGENTRED_LLM_ROUTE=first_party
# ANTHROPIC_API_KEY=

# --- Block 2: Amazon Bedrock. Needs model access granted in that region. Credentials come
# from wherever the AWS SDK finds them: a profile, an instance role, or the variables below.
# AGENTRED_LLM_ROUTE=bedrock
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Block 3: Claude Platform on AWS.
# AGENTRED_LLM_ROUTE=aws
# AWS_REGION=ap-south-1
# ANTHROPIC_AWS_WORKSPACE_ID=

# Required by every process that serves an agent under test. The targets issue refunds and
# apply discounts, so they assert this at import and crash on startup rather than warn.
AGENTRED_TARGET_MODE=test

# Where the tools an agent calls are served, and where its calls are recorded. Set per target
# process; the ports are the ones in targets.registry.yaml.
# AGENTRED_TOOL_SERVER_URL=http://localhost:8090

# Where runs are written. Defaults to out/runs, which the repository ignores. A run holds
# complete transcripts and the prompts that produced them, so point this outside a working tree
# if you keep evidence elsewhere.
# AGENTRED_RUNS_DIR=out/runs
